<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/uap"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MyLaptopProject.MyLaptop"
    Publisher="CN=MyLaptop Contributors"
    Version="3.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MyLaptop</DisplayName>
    <PublisherDisplayName>MyLaptop Contributors</PublisherDisplayName>
    <Logo>Assets\app-logo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="MyLaptopApp"
                 Executable="MyLaptop.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MyLaptop"
        Description="MyLaptop — Professional Windows desktop workspace."
        BackgroundColor="#1A73E8"
        Square150x150Logo="Assets\app-logo.png"
        Square44x44Logo="Assets\app-logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\app-logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
