<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RollForward>LatestMajor</RollForward>

    <!-- Application Identity & Metadata -->
    <AssemblyName>MyLaptop</AssemblyName>
    <RootNamespace>GeminiDesktop</RootNamespace>
    <Product>MyLaptop</Product>
    <AssemblyTitle>MyLaptop</AssemblyTitle>
    <Company>MyLaptop</Company>
    <Authors>MyLaptop Contributors</Authors>
    <Description>MyLaptop — Professional Windows desktop workspace using Microsoft Edge WebView2.</Description>
    <Copyright>Copyright (c) 2026 MyLaptop Contributors</Copyright>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Windows Packaging & DPI -->
    <ApplicationIcon>Resources\Icons\MyLaptop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\MyLaptop.ico" />
    <Resource Include="Assets\app-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
