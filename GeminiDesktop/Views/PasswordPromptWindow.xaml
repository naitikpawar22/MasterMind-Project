<Window x:Class="GeminiDesktop.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Mode Lock"
        Icon="pack://application:,,,/Resources/Icons/MyLaptop.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="400">

    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Path Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{DynamicResource AccentPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Data="M18,8 H17 V6 C17,3.24 14.76,1 12,1 C9.24,1 7,3.24 7,6 V8 H6 C4.9,8 4,8.9 4,10 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V10 C20,8.9 19.1,8 18,8 Z M12,17 C10.9,17 10,16.1 10,15 C10,13.9 10.9,13 12,13 C13.1,13 14,13.9 14,15 C14,16.1 13.1,17 12,17 Z M15.1,8 H8.9 V6 C8.9,4.29 10.29,2.9 12,2.9 C13.71,2.9 15.1,4.29 15.1,6 V8 Z" />
                <TextBlock x:Name="TitleText"
                           Text="Privacy Mode Lock"
                           Style="{StaticResource CardTitleTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="PromptMessageText"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,0,0,14" />

            <TextBlock Text="Password"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />

            <Border Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,6"
                    Margin="0,0,0,18">
                <PasswordBox x:Name="PasswordInputBox"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"
                             FontSize="13.5" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        MinWidth="84"
                        Margin="0,0,10,0"
                        Click="OnCancelClicked" />
                <Button Content="Unlock"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        MinWidth="88"
                        Click="OnConfirmClicked" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
