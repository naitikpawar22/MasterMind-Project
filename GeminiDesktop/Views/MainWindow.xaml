                        <!-- Sidebar Footer Info -->
                        <Border Grid.Row="1"
                                Margin="12"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MyLaptop Workspace"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="https://gemini.google.com/"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="Ctrl+B Sidebar · F11 Edge-to-Edge"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Main Content Area (Expands Edge-to-Edge when Sidebar Hides) -->
                <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                    <views:GeminiView DataContext="{Binding GeminiViewModel}"
                                      Visibility="{Binding DataContext.IsGeminiWorkspaceActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <views:AudioMonitorView DataContext="{Binding GeminiViewModel}"
                                            Visibility="{Binding DataContext.IsAudioMonitorActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <ContentControl Content="{Binding CurrentDetailViewModel}"
                                    Visibility="{Binding IsDetailSectionActive, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusBarMessage}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OpacityBadgeText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  |  "
                                   FontSize="11.5"
                                   Foreground="{DynamicResource BorderStrongBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PrivacyIndicatorText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  |  "
                                   FontSize="11.5"
                                   Foreground="{DynamicResource BorderStrongBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="MyLaptop · Edge WebView2"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
