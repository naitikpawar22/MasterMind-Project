                            <RadioButton Style="{StaticResource NavRailButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsPrivacyActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationSection.PrivacyAndWindowManagement}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"
