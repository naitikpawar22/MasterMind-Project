<Window x:Class="GeminiDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GeminiDesktop.Models"
        xmlns:viewModels="clr-namespace:GeminiDesktop.ViewModels"
        xmlns:views="clr-namespace:GeminiDesktop.Views"
        Title="MyLaptop"
        Icon="pack://application:,,,/Resources/Icons/MyLaptop.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        MinWidth="900"
        MinHeight="620"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="F11" Command="{Binding GeminiViewModel.ToggleToolbarCommand}" />
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.Home}" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.GeminiWorkspace}" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.Settings}" />
        <KeyBinding Key="D4" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.PrivacyAndWindowManagement}" />
        <KeyBinding Key="D5" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.About}" />
        <KeyBinding Key="D6" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationSection.AudioMonitor}" />
        <KeyBinding Key="F5" Command="{Binding GeminiViewModel.ReloadCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PrivacyViewModel}">
            <views:PrivacyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <!-- Root wrapper compensates for Windows maximized frame overhang and rounds normal corners -->
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Custom Draggable Application Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Slide Sidebar Toggle, Laptop Icon, Title, and Current Section -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,12,0">

                        <!-- Collapsible Left Sidebar Slide Button -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand"
                                ToolTip="{Binding SidebarToggleTooltip}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ToggleBg"
                                            Width="32"
                                            Height="28"
                                            CornerRadius="6"
                                            Background="Transparent">
                                        <Path Width="15"
                                              Height="13"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="M3,4 H21 C21.55,4 22,4.45 22,5 V19 C22,19.55 21.55,20 21,20 H3 C2.45,20 2,19.55 2,19 V5 C2,4.45 2.45,4 3,4 Z M4,6 V18 H9 V6 H4 Z M11,6 V18 H20 V6 H11 Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Image Source="pack://application:,,,/Assets/app-logo.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="MyLaptop"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <TextBlock Text="·"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0" />
                        <TextBlock Text="{Binding SectionTitle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status Indicators, Opacity Control, & Window Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Restore Browser Bar button when in Full Edge-to-Edge mode -->
                        <Button Command="{Binding GeminiViewModel.ToggleToolbarCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand"
                                ToolTip="Show Workspace Controls (F11)"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGeminiWorkspaceActive}" Value="True" />
                                                <Condition Binding="{Binding GeminiViewModel.IsToolbarVisible}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource AccentSubtleBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="Show Controls (F11)"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Offline Badge -->
                        <Border Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource StatusWarningBgBrush}"
                                BorderBrush="{DynamicResource StatusWarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Offline"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusWarningFgBrush}" />
                        </Border>

                        <!-- Quick Window Transparency / Background Visibility Control -->
                        <ToggleButton x:Name="OpacityButton"
                                      IsChecked="{Binding IsOpacityPopupOpen, Mode=TwoWay}"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      Cursor="Hand"
                                      ToolTip="Adjust window transparency (how much desktop background is visible)"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="OpacityPill"
                                            Background="{DynamicResource StatusNeutralBgBrush}"
                                            BorderBrush="{DynamicResource StatusNeutralBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3.5">
                                        <TextBlock Text="{Binding OpacityBadgeText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StatusNeutralFgBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OpacityPill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="OpacityPill" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsOpacityPopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=OpacityButton}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="270">
                                <StackPanel>
                                    <TextBlock Text="Window Transparency"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,10">
                                        <Run Text="Opaque: " />
                                        <Run Text="{Binding WindowOpacityPercent, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="%  ·  Background visible: " />
                                        <Run Text="{Binding BackgroundVisibilityPercent, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="%" />
                                    </TextBlock>

                                    <Slider Minimum="0.30"
                                            Maximum="1.0"
                                            SmallChange="0.05"
                                            LargeChange="0.10"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="False"
                                            Value="{Binding WindowOpacity, Mode=TwoWay}"
                                            PreviewMouseLeftButtonUp="OnOpacitySliderMouseUp"
                                            Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="100%" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11.5" Command="{Binding SetOpacityPresetCommand}" CommandParameter="100" Margin="0,0,6,0" />
                                        <Button Content="85%" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11.5" Command="{Binding SetOpacityPresetCommand}" CommandParameter="85" Margin="0,0,6,0" />
                                        <Button Content="70%" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11.5" Command="{Binding SetOpacityPresetCommand}" CommandParameter="70" Margin="0,0,6,0" />
                                        <Button Content="50%" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11.5" Command="{Binding SetOpacityPresetCommand}" CommandParameter="50" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Transparent Privacy Mode Status Pill -->
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationSection.PrivacyAndWindowManagement}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand"
                                ToolTip="Open Privacy &amp; Window Management"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pill"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            Padding="10,3.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource StatusNeutralBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusNeutralBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrivacyIndicatorActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource StatusSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M12,2 L4,5 V11 C4,16.55 7.4,21.74 12,23 C16.6,21.74 20,16.55 20,11 V5 L12,2 Z">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusNeutralFgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrivacyIndicatorActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource StatusSuccessFgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding PrivacyIndicatorText}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusNeutralFgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrivacyIndicatorActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Always-on-Top Quick Toggle -->
                        <Button Command="{Binding ToggleAlwaysOnTopCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand"
                                ToolTip="Toggle Always on Top"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PinHost"
                                            Width="30"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Width="13"
                                              Height="13"
                                              Stretch="Uniform"
                                              Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11.2 V22 H12.8 V16 H18 V14 L16,12 Z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Caption Buttons: Minimize, Maximize/Restore, Close -->
                        <Button Style="{StaticResource TitleBarCaptionButtonStyle}"
                                Command="{Binding MinimizeCommand}"
                                ToolTip="Minimize">
                            <Path Width="10" Height="1" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M0,0 H10 V1 H0 Z" />
                        </Button>

                        <Button Style="{StaticResource TitleBarCaptionButtonStyle}"
                                Command="{Binding MaximizeRestoreCommand}"
                                ToolTip="{Binding MaximizeRestoreTooltip}">
                            <Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                <Setter Property="Data" Value="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Command="{Binding CloseCommand}"
                                ToolTip="Close">
                            <Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Navigation Shell + Edge-to-Edge Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Collapsible Sliding Left Navigation Rail -->
                <Border x:Name="SidebarPanel"
                        Grid.Column="0"
                        ClipToBounds="True"
                        IsEnabled="{Binding IsSidebarVisible}"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="236" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="0"
                                                                 Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="236"
                                                                 Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Width="236">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,12,0,0">
                            <Grid Margin="18,4,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="WORKSPACE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="Minimize Sidebar (Ctrl+B)"
                                        Cursor="Hand"
                                        Width="22"
                                        Height="20"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Path Width="10" Height="10" Stretch="Uniform"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Data="M15.41,7.41 L14,6 L8,12 L14,18 L15.41,16.59 L10.83,12 Z" />
                                </Button>
                            </Grid>

                            <RadioButton Style="{StaticResource NavRailButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationSection.Home}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"
                                          Data="M10,20 V14 H14 V20 H19 V12 H22 L12,3 L2,12 H5 V20 Z" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsGeminiWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationSection.GeminiWorkspace}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"
                                          Data="M4,6 H20 V15 H4 V6 Z M2,16 H22 L23,18 H1 L2,16 Z" />
                                    <TextBlock Text="MyLaptop Workspace" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRailButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsAudioMonitorActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationSection.AudioMonitor}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"
                                          Data="M12,14 C13.66,14 15,12.66 15,11 V5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 V11 C9,12.66 10.34,14 12,14 Z M17.3,11 C17.3,14 14.76,16.1 12,16.1 C9.24,16.1 6.7,14 6.7,11 H5 C5,14.41 7.72,17.23 11,17.72 V21 H13 V17.72 C16.28,17.23 19,14.41 19,11 H17.3 Z" />
                                    <TextBlock Text="Audio &amp; Transcript" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="CONFIGURATION"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="18,18,16,8" />

                            <RadioButton Style="{StaticResource NavRailButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationSection.Settings}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"
