<UserControl x:Class="GeminiDesktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Product Identity Card -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/app-logo.png"
                           Width="64"
                           Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Top" />
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Text="{Binding ApplicationName}" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource BodyTextStyle}" MaxWidth="620"
                                   Text="A genuine Windows WPF desktop workspace built with .NET 10 and Microsoft Edge WebView2 to provide direct, authenticated access to the official Google Gemini web experience." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Runtime & Diagnostics Card -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Environment &amp; Local Storage" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text=".NET Runtime:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DotNetRuntimeDescription}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating System:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsDescription}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="WebView2 Runtime:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WebView2RuntimeVersion}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="WebView2 Profile Folder:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UserDataDirectory}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Serilog Diagnostics Folder:" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LogsDirectory}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Logs Folder"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenLogsFolderCommand}"
                                Margin="0,0,10,0" />
                        <Button Content="Open gemini.google.com in Default Browser"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenOfficialGeminiInBrowserCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Developer, Copyright, & Compliance Notice -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Developer &amp; Copyright Information" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                        <Run Text="Developer: " FontWeight="SemiBold" />
                        <Run Text="{Binding DeveloperInfo, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding CopyrightInfo}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}"
                               Text="Notice: MyLaptop is an independent Windows desktop workspace application. Google and Gemini are trademarks of Google LLC. This application loads the web workspace directly inside Microsoft Edge WebView2 without storing account credentials, intercepting conversations, or bypassing authentication." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
