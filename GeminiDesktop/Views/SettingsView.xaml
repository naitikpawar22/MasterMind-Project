<UserControl x:Class="GeminiDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:GeminiDesktop.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Configure startup behavior, appearance, browser session management, and view privacy and application details."
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Margin="0,6,0,20" />

            <!-- Feedback Banner -->
            <Border Style="{StaticResource InfoBannerStyle}"
                    Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVis}}"
                    Margin="0,0,0,18">
                <TextBlock Text="{Binding FeedbackMessage}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AccentTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- General Settings -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General Settings" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,14" />

                    <TextBlock Text="Launch Behavior (Initial Section)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Open Home Dashboard"
                                     GroupName="LaunchBehaviorGroup"
                                     IsChecked="{Binding LaunchBehavior, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:LaunchDestination.Home}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,20,0" />
                        <RadioButton Content="Open MyLaptop Workspace"
                                     GroupName="LaunchBehaviorGroup"
                                     IsChecked="{Binding LaunchBehavior, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:LaunchDestination.GeminiWorkspace}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,20,0" />
                        <RadioButton Content="Restore Last Section"
                                     GroupName="LaunchBehaviorGroup"
                                     IsChecked="{Binding LaunchBehavior, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:LaunchDestination.LastVisited}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding LaunchOnWindowsStartup}"
                              Content="Start MyLaptop automatically when signing in to Windows"
                              Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding StartMinimized}"
                              Content="Start application minimized to the taskbar"
                              Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding ShowMiniPopupWhenMinimized}"
                              Content="Show compact MyLaptop popup widget when minimized"
                              Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding RememberLastWindowPosition}"
                              Content="Remember previous window size, monitor, and position"
                              Margin="0,0,0,16" />

                    <TextBlock Text="Default Window Size" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Compact (1040×700)"
                                     GroupName="WindowSizeGroup"
                                     IsChecked="{Binding WindowSizePreset, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:DefaultWindowSizePreset.Compact}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Standard (1280×820)"
                                     GroupName="WindowSizeGroup"
                                     IsChecked="{Binding WindowSizePreset, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:DefaultWindowSizePreset.Standard}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Wide (1480×920)"
                                     GroupName="WindowSizeGroup"
                                     IsChecked="{Binding WindowSizePreset, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:DefaultWindowSizePreset.Wide}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Custom"
                                     GroupName="WindowSizeGroup"
                                     IsChecked="{Binding WindowSizePreset, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:DefaultWindowSizePreset.Custom}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsCustomWindowSize, Converter={StaticResource BoolToVis}}"
                                Margin="0,4,0,10">
                        <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding DefaultWindowWidth, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90"
                                 Margin="0,0,16,0" />
                        <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding DefaultWindowHeight, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90" />
                    </StackPanel>

                    <Button Content="Apply Default Window Size Now"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ApplyDefaultWindowSizeCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,6" />
                    <TextBlock Text="Select the desktop shell color scheme. Theme changes apply immediately."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Light Theme (Default)"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:AppThemeMode.Light}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,22,0" />
                        <RadioButton Content="Dark Theme"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:AppThemeMode.Dark}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,22,0" />
                        <RadioButton Content="System Default"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static models:AppThemeMode.SystemDefault}}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="Window Transparency (Background Visibility)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                        <Run Text="Window Opacity: " />
                        <Run Text="{Binding WindowOpacityPercent, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="%  ·  Background Visible: " />
                        <Run Text="{Binding BackgroundVisibilityPercent, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="%" />
                    </TextBlock>

                    <Slider Minimum="0.30"
                            Maximum="1.0"
                            SmallChange="0.05"
                            LargeChange="0.10"
                            TickFrequency="0.05"
                            Value="{Binding WindowOpacity, Mode=TwoWay}"
                            MaxWidth="420"
                            HorizontalAlignment="Left"
                            Width="360"
                            Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="100% (Solid)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Command="{Binding SetOpacityPresetCommand}" CommandParameter="100" Margin="0,0,8,0" />
                        <Button Content="85%" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Command="{Binding SetOpacityPresetCommand}" CommandParameter="85" Margin="0,0,8,0" />
                        <Button Content="70%" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Command="{Binding SetOpacityPresetCommand}" CommandParameter="70" Margin="0,0,8,0" />
                        <Button Content="50%" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Command="{Binding SetOpacityPresetCommand}" CommandParameter="50" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Browser Settings -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Browser Settings" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="Gemini Homepage URL (HTTPS on gemini.google.com)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding GeminiHomepageUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0" />
                        <Button Grid.Column="1"
                                Content="Reset URL"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResetHomepageUrlCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding UrlValidationError}"
                               Foreground="{DynamicResource StatusDangerFgBrush}"
                               FontSize="12"
                               Visibility="{Binding UrlValidationError, Converter={StaticResource StringToVis}}"
                               Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding OpenExternalLinksInSystemBrowser}"
                              Content="Open third-party HTTPS links in your default Windows browser"
                              Margin="0,6,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Browser Session"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshBrowserSessionCommand}"
                                Margin="0,0,10,0" />
                        <Button Content="Clear Browser Cache"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearBrowserCacheCommand}"
                                Margin="0,0,10,0" />
                        <Button Content="Reset Browser Workspace"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ResetBrowserWorkspaceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dual Audio Input, System Loopback, & Live Speech Recognition -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Microphone, System Audio &amp; Live Speech Recognition" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,6" />
                    <TextBlock Text="Capture physical microphone voice input and Windows playback output (loopback) simultaneously, with separate controls and real-time speech transcription."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,0,0,14" />

                    <!-- Source 1: Physical Microphone -->
                    <TextBlock Text="1. Preferred Microphone Device" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding MicrophoneDevices}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="FriendlyName"
                                  SelectedValue="{Binding SelectedMicrophoneId, Mode=TwoWay}"
                                  Height="32"
                                  Padding="8,4"
                                  Margin="0,0,10,0" />
                        <Button Grid.Column="1"
                                Content="Refresh Devices"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshMicrophonesCommand}" />
                    </Grid>

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding AllowMicrophoneAccess}"
                              Content="Allow microphone permission for MyLaptop Workspace"
                              Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding EnableMicrophoneLevelMonitoring}"
                              Content="Enable physical microphone capture &amp; activity meter"
                              Margin="0,0,0,10" />

                    <TextBlock Text="Microphone Input Activity" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding MicrophoneLevelPercent, Mode=OneWay}"
                                     Background="{DynamicResource SurfaceSecondaryBrush}"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     VerticalAlignment="Center">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFgBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MicrophoneLevelPercent, StringFormat={}{0}%}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding MicrophoneStatusText}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource WarningBannerStyle}"
                            Visibility="{Binding MicrophoneErrorMessage, Converter={StaticResource StringToVis}}"
                            Margin="0,0,0,10">
                        <TextBlock Text="{Binding MicrophoneErrorMessage}"
                                   Foreground="{DynamicResource StatusWarningFgBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Start Microphone"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StartMicrophoneCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Stop Microphone"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StopMicrophoneCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding MicrophoneMuteButtonText}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleMicrophoneMuteCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Windows Mic Privacy"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenWindowsMicPrivacyCommand}" />
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14" />

                    <!-- Source 2: Windows System Audio Loopback -->
                    <TextBlock Text="2. System Audio Output Loopback (Google Meet, Zoom, Teams, Browsers)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding SystemAudioDevices}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="FriendlyName"
                                  SelectedValue="{Binding SelectedSystemAudioDeviceId, Mode=TwoWay}"
                                  Height="32"
                                  Padding="8,4"
                                  Margin="0,0,10,0" />
                        <Button Grid.Column="1"
                                Content="Refresh Outputs"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshSystemAudioCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ActiveSystemAudioDeviceName, StringFormat=Active Output Endpoint: {0}}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding EnableSystemAudioMonitoring}"
                              Content="Capture Windows system audio output simultaneously via WASAPI loopback"
                              Margin="0,0,0,10" />

                    <TextBlock Text="System Audio Activity &amp; Live Waveform" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Height="30"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6,2"
                                Margin="0,0,10,0">
                            <ItemsControl ItemsSource="{Binding SystemAudioWaveformBars}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="4" Height="{Binding}" CornerRadius="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSystemAudioMuted, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ProgressBar Grid.Column="1"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SystemAudioLevelPercent, Mode=OneWay}"
                                     Background="{DynamicResource SurfaceSecondaryBrush}"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     VerticalAlignment="Center">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemAudioMuted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SystemAudioLevelPercent, StringFormat={}{0}%}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SystemAudioStatusText}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource WarningBannerStyle}"
                            Visibility="{Binding SystemAudioErrorMessage, Converter={StaticResource StringToVis}}"
                            Margin="0,0,0,10">
                        <TextBlock Text="{Binding SystemAudioErrorMessage}"
                                   Foreground="{DynamicResource StatusWarningFgBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Start System Audio"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StartSystemAudioCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Stop System Audio"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StopSystemAudioCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding SystemAudioMuteButtonText}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleSystemAudioMuteCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Refresh Output"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshSystemAudioCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Windows Sound"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenWindowsSoundSettingsCommand}" />
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14" />

                    <!-- Speech Recognition -->
                    <TextBlock Text="3. Real-Time Speech-to-Text Engine" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding EnableLiveSpeechTranscription}"
                              Content="Convert Microphone &amp; System Audio speech into source-tagged text in real time"
                              Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}">
                        <Run Text="Engine: " FontWeight="SemiBold" />
                        <Run Text="{Binding RecognizerDisplayName, Mode=OneWay}" />
                        <Run Text="  ·  Status: " />
                        <Run Text="{Binding TranscriptionStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <Border Style="{StaticResource WarningBannerStyle}"
                            Visibility="{Binding TranscriptionErrorMessage, Converter={StaticResource StringToVis}}"
                            Margin="0,8,0,0">
                        <TextBlock Text="{Binding TranscriptionErrorMessage}"
                                   Foreground="{DynamicResource StatusWarningFgBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Privacy Settings Summary -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy Settings &amp; Screen-Sharing Limitations" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10" />

                    <TextBlock Text="Current Status" Style="{StaticResource MutedCaptionTextStyle}" />
                    <TextBlock Text="{Binding PrivacyCurrentStatus}" FontWeight="SemiBold" Margin="0,2,0,8" />

                    <TextBlock Text="Supported Windows Capabilities" Style="{StaticResource MutedCaptionTextStyle}" />
                    <TextBlock Text="{Binding PrivacyCapabilitySummary}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,8" />

                    <TextBlock Text="Screen-Sharing Limitations" Style="{StaticResource MutedCaptionTextStyle}" />
                    <TextBlock Text="{Binding PrivacyLimitationSummary}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,12" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding IsPrivacyModeEnabled}"
                              IsEnabled="{Binding IsPrivacyModeSupported}"
                              Content="Enable Privacy Mode now (password required only when turning ON → OFF)"
                              Margin="0,0,0,10" />

                    <CheckBox Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding EnableCaptureExclusionByDefault}"
                              Content="Enable Privacy Mode automatically when MyLaptop starts"
                              Margin="0,0,0,12" />

                    <Button Content="Open Privacy &amp; Window Management"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenPrivacyModuleCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- About Summary -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="About Application" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                        <Run Text="Application: " FontWeight="SemiBold" />
                        <Run Text="{Binding ApplicationName, Mode=OneWay}" />
                        <Run Text="  (v" />
                        <Run Text="{Binding ApplicationVersion, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                        <Run Text="Developer: " FontWeight="SemiBold" />
                        <Run Text="{Binding DeveloperInfo, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding CopyrightInfo}" Style="{StaticResource MutedCaptionTextStyle}" Margin="0,0,0,12" />
                    <Button Content="View Full System &amp; About Details"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenAboutViewCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Save / Reset Controls -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save Settings"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        Margin="0,0,12,0" />
                <Button Content="Reset All Settings to Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetToDefaultsCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
