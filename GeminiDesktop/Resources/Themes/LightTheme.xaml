<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (Bright white & light-grey traditional Windows desktop palette) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#E8F0FE" />

    <!-- Titlebar & Status Bar -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseHoverFgBrush" Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />

    <!-- Brand & Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#1A73E8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1557B0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#174EA6" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#174EA6" />
    <SolidColorBrush x:Key="AccentForegroundOnFillBrush" Color="#FFFFFF" />

    <!-- Status Pills & Banners -->
    <SolidColorBrush x:Key="StatusNeutralBgBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="StatusNeutralFgBrush" Color="#334155" />
    <SolidColorBrush x:Key="StatusNeutralBorderBrush" Color="#CBD5E1" />

    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="StatusSuccessFgBrush" Color="#047857" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#A7F3D0" />

    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="StatusWarningFgBrush" Color="#B45309" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#FDE68A" />

    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="StatusDangerFgBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="#FECACA" />

    <!-- Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />

</ResourceDictionary>
