<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (Balanced neutral dark desktop palette) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#161F2E" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#293548" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#1E3A5F" />

    <!-- Titlebar & Status Bar -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#161F2E" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#293548" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#161F2E" />
    <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseHoverFgBrush" Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Brand & Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="AccentForegroundOnFillBrush" Color="#FFFFFF" />

    <!-- Status Pills & Banners -->
    <SolidColorBrush x:Key="StatusNeutralBgBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="StatusNeutralFgBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="StatusNeutralBorderBrush" Color="#475569" />

    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#064E3B" />
    <SolidColorBrush x:Key="StatusSuccessFgBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#059669" />

    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#451A03" />
    <SolidColorBrush x:Key="StatusWarningFgBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#B45309" />

    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="#450A0A" />
    <SolidColorBrush x:Key="StatusDangerFgBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="#DC2626" />

    <!-- Controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="#475569" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />

</ResourceDictionary>
