<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clean Desktop Surface Card -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Status Notice Banners -->
    <Style x:Key="InfoBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="WarningBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusWarningBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="DangerBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusDangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="SuccessBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusSuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

</ResourceDictionary>
